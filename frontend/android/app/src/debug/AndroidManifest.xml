<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Aplica a network_security_config abaixo SÓ no build de debug (o
         Android Gradle Plugin mescla esse <application> com o de
         src/main/AndroidManifest.xml, adicionando o atributo sem duplicar o
         resto). Nunca propague isso pro build de release. -->
    <application android:networkSecurityConfig="@xml/network_security_config"/>
</manifest>
